      "source": [
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "\n",
        "features_for_recommendation = [col for col in df_encoded.columns if col not in ['price', 'budget_category', 'budget_category_encoded']]\n",
        "\n",
        "X_recommendation = df_encoded[features_for_recommendation].copy()\n",
        "\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X_recommendation)\n",
        "\n",
        "\n",
        "similarity_matrix = cosine_similarity(X_scaled)\n",
        "\n",
        "def recommend_similar_houses(house_index, df_for_model, similarity_matrix, df_for_display, num_recommendations=5):\n",
        "    similarity_scores = list(enumerate(similarity_matrix[house_index]))\n",
        "\n",
        "    similarity_scores = sorted(similarity_scores, key=lambda x: x[1], reverse=True)\n",
        "\n",
        "    top_similar_houses = similarity_scores[1:num_recommendations+1]\n",
        "\n",
        "    recommended_indices = [i[0] for i in top_similar_houses]\n",
        "\n",
        "    return df_for_display.iloc[recommended_indices][['property_name', 'square_feet', 'floor', 'price_per_sqft', 'price']]\n",
        "\n",
        "random_house_index = np.random.randint(0, len(df_encoded))\n",
        "print(f\"Original house at index {random_house_index}:\")\n",
        "display(df_no_outliers.iloc[[random_house_index]][['property_name', 'square_feet', 'floor', 'price_per_sqft', 'price']])\n",
        "\n",
        "recommended_houses = recommend_similar_houses(random_house_index, df_encoded, similarity_matrix, df_no_outliers)\n",
        "print(f\"\\nRecommended similar houses (top 5 for house at index {random_house_index}):\")\n",
        "display(recommended_houses)"
      ],
