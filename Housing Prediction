      },
      "source": [
        "df_cleaned = df.copy()\n",
        "\n",
        "df_cleaned['square_feet'] = df_cleaned['square_feet'].astype(str).str.replace(r'[^0-9.]', '', regex=True)\n",
        "df_cleaned['square_feet'] = pd.to_numeric(df_cleaned['square_feet'], errors='coerce')\n",
        "\n",
        "median_sqft = df_cleaned['square_feet'].median()\n",
        "df_cleaned['square_feet'] = df_cleaned['square_feet'].fillna(median_sqft)\n",
        "\n",
        "df_cleaned['price_per_sqft'] = df_cleaned['price_per_sqft'].astype(str).str.replace(r'[₹,a-zA-Z/]', '', regex=True).str.strip()\n",
        "df_cleaned['price_per_sqft'] = pd.to_numeric(df_cleaned['price_per_sqft'], errors='coerce')\n",
        "\n",
        "median_price_per_sqft = df_cleaned['price_per_sqft'].median()\n",
        "df_cleaned['price_per_sqft'] = df_cleaned['price_per_sqft'].fillna(median_price_per_sqft)\n",
        "\n",
        "def convert_price(price_str):\n",
        "    price_str = price_str.replace('₹', '').replace(',', '').strip()\n",
        "    if 'Lac' in price_str:\n",
        "        return float(price_str.replace('Lac', '').strip()) * 100000\n",
        "    elif 'Cr' in price_str:\n",
        "        return float(price_str.replace('Cr', '').strip()) * 10000000\n",
        "    return pd.to_numeric(price_str, errors='coerce')\n",
        "\n",
        "df_cleaned['price'] = df_cleaned['price'].apply(convert_price)\n",
        "\n",
        "median_price = df_cleaned['price'].median()\n",
        "df_cleaned['price'] = df_cleaned['price'].fillna(median_price)\n",
        "\n",
        "df_cleaned = df_cleaned[df_cleaned['price'] > 100000]\n",
        "df_cleaned = df_cleaned[df_cleaned['square_feet'] > 10]\n",
        "\n",
        "df_cleaned['price_per_sqft'] = df_cleaned['price'] / df_cleaned['square_feet']\n",
        "\n",
        "df_cleaned['floor'] = df_cleaned['floor'].astype(str).str.extract(r'(\\d+)', expand=False)\n",
        "df_cleaned['floor'] = pd.to_numeric(df_cleaned['floor'], errors='coerce')\n",
        "\n",
        "median_floor = df_cleaned['floor'].median()\n",
        "df_cleaned['floor'] = df_cleaned['floor'].fillna(median_floor)\n",
        "\n",
        "df_cleaned['bhk'] = df_cleaned['property_name'].str.extract(r'(\\d+)\\s*BHK', expand=False)\n",
        "df_cleaned['bhk'] = pd.to_numeric(df_cleaned['bhk'], errors='coerce')\n",
        "\n",
        "mode_bhk = df_cleaned['bhk'].mode()[0]\n",
        "df_cleaned['bhk'] = df_cleaned['bhk'].fillna(mode_bhk)\n",
        "\n",
        "\n",
        "print(df_cleaned.info())\n",
        "display(df_cleaned.head())"
      ],
