      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "from xgboost import XGBClassifier\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "\n",
        "low_budget_threshold = df_encoded['price'].quantile(0.33)\n",
        "medium_budget_threshold = df_encoded['price'].quantile(0.66)\n",
        "\n",
        "def categorize_budget(price):\n",
        "    if price <= low_budget_threshold:\n",
        "        return 'Low budget'\n",
        "    elif price <= medium_budget_threshold:\n",
        "        return 'Medium budget'\n",
        "    else:\n",
        "        return 'Premium property'\n",
        "\n",
        "df_encoded['budget_category'] = df_encoded['price'].apply(categorize_budget)\n",
        "\n",
        "\n",
        "le = LabelEncoder()\n",
        "df_encoded['budget_category_encoded'] = le.fit_transform(df_encoded['budget_category'])\n",
        "\n",
        "X_classification = df_encoded.drop(['price', 'budget_category', 'budget_category_encoded'], axis=1)\n",
        "y_classification = df_encoded['budget_category_encoded']\n",
        "\n",
        "\n",
        "common_cols = list(set(X_classification.columns) & set(X.columns))\n",
        "missing_in_X_classification = list(set(X.columns) - set(X_classification.columns))\n",
        "missing_in_X = list(set(X_classification.columns) - set(X.columns))\n",
        "\n",
        "for col in missing_in_X_classification:\n",
        "    X_classification[col] = 0\n",
        "for col in missing_in_X:\n",
        "    X[col] = 0\n",
        "\n",
        "X_classification = X_classification[X.columns]\n",
        "\n",
        "\n",
        "X_train_cls, X_test_cls, y_train_cls, y_test_cls = train_test_split(\n",
        "    X_classification, y_classification, test_size=0.2, random_state=42, stratify=y_classification\n",
        ")\n",
        "\n",
        "print(\"Budget category distribution:\")\n",
        "print(df_encoded['budget_category'].value_counts())\n",
        "print(f\"\\nX_train_cls shape: {X_train_cls.shape}\")\n",
        "print(f\"X_test_cls shape: {X_test_cls.shape}\")\n",
