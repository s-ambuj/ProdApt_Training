      "source": [
        "df_processed = df_no_outliers.copy()\n",
        "\n",
        "missing_percentage = df_processed.isnull().sum() / len(df_processed) * 100\n",
        "sparse_cols = missing_percentage[missing_percentage > 50].index.tolist()\n",
        "\n",
        "sparse_bool_cols = []\n",
        "for col in df_processed.select_dtypes(include='bool').columns:\n",
        "    true_count = df_processed[col].sum()\n",
        "    false_count = len(df_processed) - true_count\n",
        "\n",
        "    if true_count == 0 or false_count == 0:\n",
        "        sparse_bool_cols.append(col)\n",
        "        continue\n",
        "\n",
        "    true_ratio = true_count / len(df_processed)\n",
        "    false_ratio = false_count / len(df_processed)\n",
        "\n",
        "    threshold_true_ratio = 0.99\n",
        "    threshold_false_ratio = 0.99\n",
        "\n",
        "    if true_ratio > threshold_true_ratio or false_ratio > threshold_false_ratio:\n",
        "        sparse_bool_cols.append(col)\n",
        "\n",
        "\n",
        "columns_to_drop = ['property_name', 'areaWithType'] + sparse_cols + sparse_bool_cols\n",
        "\n",
        "columns_to_drop = list(set(columns_to_drop))\n",
        "\n",
        "df_processed = df_processed.drop(columns=columns_to_drop, errors='ignore')\n",
        "\n",
        "print(\"Columns dropped due to sparseness or high cardinality:\", columns_to_drop)\n",
        "print(f\"New DataFrame shape: {df_processed.shape}\")\n",
        "display(df_processed.head())"
